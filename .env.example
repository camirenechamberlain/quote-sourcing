# --- Google ---------------------------------------------------------------
# Places API (New) + Geocoding API key, restricted to those two APIs
GOOGLE_PLACES_API_KEY=
# Desktop-app OAuth client (current local Gmail flow; replaced by the email provider in Phase 2)
GOOGLE_OAUTH_CLIENT_SECRET_FILE=data/client_secret.json

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# INTAKE_MODEL=claude-sonnet-5-5

# --- Website ----------------------------------------------------------------
# Public https URL of the site (no trailing slash), used for progress links, e.g. https://quoteschmote.com
PUBLIC_BASE_URL=

# --- Safety -----------------------------------------------------------------
# dry_run = nothing is sent to anyone, messages are only recorded. live = real sends.
OUTBOUND_MODE=dry_run

# --- Hosting ----------------------------------------------------------------
# Postgres in production (Railway sets this). Unset = local SQLite at data/app.db.
# DATABASE_URL=

# --- Website chat -------------------------------------------------------------
# DAILY_QUOTE_LIMIT=10
# GLOBAL_DAILY_JOBS=50
# IP_DAILY_SESSIONS=20
# MAX_MESSAGES_PER_SESSION=60
# GLOBAL_DAILY_MESSAGES=1500
# Set to 1 ONLY when running behind Cloudflare Tunnel / a trusted proxy (trusts CF-Connecting-IP for rate limits)
# TRUST_PROXY_HEADERS=0
# REVIEW_THOROUGH=0   # 1 = the supplier review also asks 'minor' nice-to-know questions, not only essential/important ones
# ESTIMATE_MODEL=claude-haiku-5-5   # cheap vision model for 'Estimate from my photo'
# MAX_ESTIMATES_PER_REQUEST=3
# PHOTOS_FIRST=1        # 1 = ask for photos before any question and let the reviewer read them; 0 = ask questions straight away
# MAX_REVIEW_PHOTOS=4   # photos shown to the reviewer (about 1,000 tokens each)
